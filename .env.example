META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_CONFIG_ID=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
FRONTEND_URL=http://localhost:5173

# Authentication: local HTTP is allowed only on loopback addresses.
APP_ENV=development
API_PUBLIC_URL=http://localhost:3000
# 'file' saves private .eml previews in the app directory; it never sends real email.
# Production MUST use APP_ENV=production + AUTH_MAIL_MODE=smtp + same-origin HTTPS URLs.
AUTH_MAIL_MODE=file
AUTH_OUTBOX_DIR=.marketflow-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Google OAuth web application. Callback: API_PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Consumer Facebook Login; separate from the existing Meta Ads integration above.
# Select the supported Graph API version shown in your Meta app dashboard.
FACEBOOK_LOGIN_APP_ID=
FACEBOOK_LOGIN_APP_SECRET=
FACEBOOK_LOGIN_GRAPH_VERSION=

# Vite build-time value; production serves API under the same HTTPS origin.
VITE_API_BASE_URL=http://localhost:3000

# Optional Creative Studio model generation. Keep this key server-side only.
# Without it the studio explicitly uses guided templates and manual editing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
